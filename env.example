# Database Configuration
PG_HOST=postgres
PG_PORT=5432
PG_USER=vector
PG_PASSWORD=vectorpwd
PG_DB=pipelines

# AWS Configuration (for S3 sinks)
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
AWS_DEFAULT_REGION=ap-southeast-2

# Frontend AWS Configuration (React environment variables)
REACT_APP_AWS_ACCESS_KEY_ID=your_aws_access_key_here
REACT_APP_AWS_SECRET_ACCESS_KEY=your_aws_secret_key_here
REACT_APP_AWS_DEFAULT_REGION=ap-southeast-2

# Application Configuration
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# Docker Configuration
DOCKER_HOST=unix:///var/run/docker.sock 